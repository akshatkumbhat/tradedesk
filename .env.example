# Alpaca paper-trading keys — get free keys at https://app.alpaca.markets
# (sign up -> dashboard -> "Paper" account -> API Keys). Copy this file to .env.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Live trading keys (optional; required only to enable Live mode in the dashboard).
# Generate from your real-money Alpaca account. Leave empty to keep live mode locked.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
